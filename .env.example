# XENIA - Example environment variables
# Copy to .env and fill values for production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# Application
SECRET_KEY=replace-with-secret
CORS_ORIGINS=http://localhost:3000

# Limits & timeouts
MAX_FILE_SIZE_MB=50
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=20

# Database / Supabase related
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
MAX_CONCURRENT_REQUESTS=50
SB_CIRCUIT_FAILURE_THRESHOLD=5
SB_CIRCUIT_RECOVERY_TIMEOUT=60

# Monitoring
ENABLE_ERROR_TRACKING=false
ENABLE_PERFORMANCE_MONITORING=false
###############################
# XENIA Environment Template  #
###############################

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role (only for server-side back-end; NEVER expose in frontend build)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Keys (set what you have; system falls back automatically)
# At least one of these should be valid for full functionality.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# YouTube (optional) – enables richer video recommendations
YOUTUBE_API_KEY=your-youtube-api-key

# Embeddings
# EMBEDDING_PROVIDER options: gemini | openai
EMBEDDING_PROVIDER=gemini
# Gemini embedding default model (prefixed automatically if not fully-qualified)
EMBEDDING_MODEL=text-embedding-004

# Storage
ARTIFACTS_BUCKET=artifacts

# Backend Runtime
FLASK_ENV=development
FLASK_DEBUG=true
LOG_LEVEL=INFO

# Frontend Config (used by Next.js when prefixed with NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Removed: AI_MOCK (legacy mock mode eliminated)
# If you previously relied on mock mode, all endpoints now require real configuration.

# Notes:
# - Do NOT expose SUPABASE_SERVICE_ROLE_KEY in client builds.
# - If YOUTUBE_API_KEY is unset, video list may be sparse (no scraping fallback for compliance).
# - Provide at least GEMINI_API_KEY or OPENAI_API_KEY for AI features (topic extraction, analysis).
# - Adjust LOG_LEVEL to DEBUG for verbose tracing during development.
